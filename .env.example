# Copy to .env.local and fill in. All values are optional in development.

# The public URL of the site. Used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://travlcares.com

# The REAL business phone number. Both are required before launch.
# Display format shown to visitors:
NEXT_PUBLIC_PHONE_DISPLAY=
# E.164 format used in tel: links, e.g. +18005550123
NEXT_PUBLIC_PHONE_E164=
